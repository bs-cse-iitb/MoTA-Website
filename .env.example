# Environment variables read by the scripts in this project. All are optional;
# the site itself needs no secrets to build. To use a local copy:
#   cp .env.example .env    # then edit; .env is git-ignored
#   set -a; . ./.env; set +a
# Placeholders only. Never put passwords, API keys or connection strings here.

# Chrome or Chromium used by the test suites (puppeteer-core).
# Default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# Folder for test evidence and generated documents.
# Default: docs (next to this folder)
MOTA_DOCS_DIR=

# Legacy ASP.NET "App" folder, read only by the one-time import tools
# (scripts/harvest/harvest.py, npm run assets). Default: ../MoTA_Website_Old/App
LEGACY_DIR=
