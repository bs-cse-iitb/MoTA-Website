---
// Social platform glyphs (Simple Icons, CC0).
import { siX, siFacebook, siInstagram, siYoutube } from 'simple-icons';

interface Props { id: 'x' | 'facebook' | 'instagram' | 'youtube'; class?: string }
const { id, class: cls = 'icon' } = Astro.props;
const map = { x: siX, facebook: siFacebook, instagram: siInstagram, youtube: siYoutube };
const icon = map[id];
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={icon.path} /></svg>
